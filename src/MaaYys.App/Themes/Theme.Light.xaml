<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 明色主题：所有键必须与 Theme.Dark.xaml 一一对应，否则切换时会丢失资源 -->
    <Color x:Key="WindowBackgroundColor">#F3F3F3</Color>
    <Color x:Key="PanelBackgroundColor">#FFFFFF</Color>
    <Color x:Key="NavBackgroundColor">#EAEAEA</Color>
    <Color x:Key="NavHoverColor">#DCDCDC</Color>
    <Color x:Key="NavSelectedColor">#D6E8FA</Color>
    <Color x:Key="BorderColor">#D0D0D0</Color>
    <Color x:Key="ForegroundPrimaryColor">#1A1A1A</Color>
    <Color x:Key="ForegroundSecondaryColor">#5A5A5A</Color>
    <Color x:Key="AccentColor">#0078D4</Color>
    <Color x:Key="AccentForegroundColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#EAEAEA" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#DCDCDC" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#D6E8FA" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D0D0D0" />
    <SolidColorBrush x:Key="ForegroundPrimaryBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="ForegroundSecondaryBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

    <!-- 禁用态反馈：WPF 默认模板在显式设置 Background 后，禁用按钮外观几乎不变，
         用户无法判断"按钮为什么点不动"（实例页的保存/连接按钮都踩过）。 -->
    <Style TargetType="Button">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- CheckBox 的文字颜色：默认模板的 ContentPresenter 不继承窗口前景色，显式指定以保持两种主题一致。 -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
