<Window x:Class="MaaYys.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MaaYys.App.ViewModels"
        xmlns:pages="clr-namespace:MaaYys.App.Views.Pages"
        Title="{Binding Title}"
        Height="720" Width="1180"
        MinWidth="900" MinHeight="560"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundPrimaryBrush}">

    <Window.Resources>
        <!-- ViewModel → View 映射：ContentControl.Content 绑定 VM 即可自动套用 -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <pages:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TasksViewModel}">
            <pages:TasksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TimersViewModel}">
            <pages:TimersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <pages:LogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
            <pages:ConnectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstancesViewModel}">
            <pages:InstancesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <pages:SettingsView />
        </DataTemplate>

        <Style x:Key="NavItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 实例标签条：圆点=连接状态，点 × 删除（列表仅一项时禁用） -->
        <Style x:Key="InstanceTabStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Padding="10,4" Background="Transparent"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部栏：标题 / 运行控制（P5.3 启用） / 主题切换 -->
        <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="开始" Width="88" Height="32" Margin="0,0,8,0" IsEnabled="False"
                            Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentForegroundBrush}"
                            BorderThickness="0" />
                    <Button Content="停止" Width="88" Height="32" Margin="0,0,8,0" IsEnabled="False" />
                    <Button Content="{Binding ThemeLabel}" Width="88" Height="32"
                            Command="{Binding ToggleThemeCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 实例标签条（P2.4 多开） -->
        <Border Grid.Row="1" Padding="12,6" Background="{DynamicResource NavBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <ListBox ItemsSource="{Binding Instances}"
                             SelectedItem="{Binding CurrentInstance, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource InstanceTabStyle}"
                             Background="Transparent" BorderThickness="0" Padding="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#6E6E78" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="{x:Static vm:InstanceState.Connecting}">
                                                        <Setter Property="Fill" Value="#E0A030" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="{x:Static vm:InstanceState.Connected}">
                                                        <Setter Property="Fill" Value="#3FAE6A" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="{x:Static vm:InstanceState.Error}">
                                                        <Setter Property="Fill" Value="#E05C5C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TabSubtitle}" FontSize="10" Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                                    <Button Margin="8,0,0,0" Padding="3" Width="18" Height="18"
                                            VerticalAlignment="Center" ToolTip="删除实例"
                                            BorderThickness="0" Background="Transparent"
                                            Command="{Binding DataContext.CloseInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Path Data="M0,0 L7,7 M7,0 L0,7" Width="7" Height="7"
                                              Stretch="None" StrokeThickness="1.3"
                                              Stroke="{DynamicResource ForegroundSecondaryBrush}" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Content="＋ 新建实例" Height="26" Padding="10,0" FontSize="12"
                            Margin="2,0,0,0" VerticalAlignment="Center"
                            Command="{Binding AddInstanceCommand}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 主体：左侧导航 + 右侧内容 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="184" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource NavBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <ListBox ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavItemContainerStyle}"
                         Background="Transparent" BorderThickness="0" Padding="0,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontSize="15" Width="24"
                                           Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                                <TextBlock Text="{Binding Name}" FontSize="14" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="16" />
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Padding="12,6" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="12" />
        </Border>
    </Grid>
</Window>
