<Window x:Class="MaaYys.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MaaYys.App.ViewModels"
        xmlns:pages="clr-namespace:MaaYys.App.Views.Pages"
        Title="{Binding Title}"
        Height="780" Width="1320"
        MinWidth="1040" MinHeight="640"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundPrimaryBrush}">

    <Window.Resources>
        <!-- ViewModel → View 映射：ContentControl.Content 绑定 VM 即可自动套用 -->
        <DataTemplate DataType="{x:Type vm:TasksViewModel}">
            <pages:TasksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstancesViewModel}">
            <pages:InstancesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToolsViewModel}">
            <pages:ToolsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TimersViewModel}">
            <pages:TimersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <pages:LogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <pages:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
            <pages:ConnectionView />
        </DataTemplate>

        <!-- 顶部页签（MAA 式）：文字 + 选中下划线 -->
        <Style x:Key="TopTabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <Border x:Name="Bd" Height="50" Padding="24,0" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Line" Height="3" VerticalAlignment="Bottom"
                                    Background="Transparent" Margin="18,0" CornerRadius="1.5" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Line" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 顶部：页签 + 实例切换 + 主题 ============ -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ListBox Grid.Column="0" ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource TopTabItemStyle}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontSize="14.5" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <!-- 当前实例：多开时在这里快速切，详细配置在「多实例」页 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#6E6E78" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentInstance.State}" Value="{x:Static vm:InstanceState.Connecting}">
                                            <Setter Property="Fill" Value="#E0A030" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentInstance.State}" Value="{x:Static vm:InstanceState.Connected}">
                                            <Setter Property="Fill" Value="#3FAE6A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentInstance.State}" Value="{x:Static vm:InstanceState.Error}">
                                            <Setter Property="Fill" Value="#E05C5C" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <ComboBox Height="28" MinWidth="130" MaxWidth="200"
                                  ItemsSource="{Binding Instances}"
                                  SelectedItem="{Binding CurrentInstance, Mode=TwoWay}"
                                  ToolTip="当前实例（在「多实例」页管理）">
                            <!-- 用 ItemTemplate 而不是 DisplayMemberPath：自定义模板下
                                 SelectionBoxItemTemplate 只在有模板时才拿得到，否则会显示类名 -->
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <Button Content="{Binding ThemeLabel}" Width="60" Height="28" FontSize="12"
                            Command="{Binding ToggleThemeCommand}" ToolTip="切换明暗主题" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 内容 ============ -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="14" />

        <!-- ============ 状态栏 ============ -->
        <Border Grid.Row="2" Padding="14,6" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11.5"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Tasks.RunOverview}" FontSize="11.5"
                           Margin="16,0,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                           ToolTip="{Binding Tasks.RunOverview}" />
            </Grid>
        </Border>
    </Grid>
</Window>
