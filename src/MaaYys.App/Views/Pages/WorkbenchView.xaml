<UserControl x:Class="MaaYys.App.Views.Pages.WorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MaaYys.App.Views.Controls"
             Background="Transparent">
    <!--
        主界面（P6.1）：左任务链 + 右「连接 / 截图 / 日志」三面板。
        三块都是既有数据源的投影，不复制状态：任务链与任务页是同一个 TasksViewModel。
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
        </Style>

        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- 面板标题栏：图标 + 标题 + 右侧信息 + 折叠箭头 -->
        <Style x:Key="PanelHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PanelGlyph" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
        </Style>

        <Style x:Key="CollapseButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
        </Style>

        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- 日志行（与日志页同配色，面板里只保留必要字段） -->
        <Style x:Key="LogLevelText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Width" Value="42" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Error">
                    <Setter Property="Foreground" Value="#E05A5A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warn">
                    <Setter Property="Foreground" Value="#D9A227" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Info">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LogTimeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
        </Style>

        <Style x:Key="LogMessageText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="PlainListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="2,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左：任务链 ============ -->
        <Border Grid.Column="0" Padding="12" CornerRadius="8"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="配置组" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Column="1" Height="26" ItemsSource="{Binding Tasks.ConfigurationNames}"
                              SelectedItem="{Binding Tasks.SelectedConfiguration, Mode=TwoWay}" />
                </Grid>

                <controls:TaskQueueView Grid.Row="1" DataContext="{Binding Tasks}" />
            </Grid>
        </Border>

        <!-- ============ 右：连接 / 截图 / 日志 ============ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="{Binding DataContext.ConnectionPanel.RowHeight, ElementName=Root}" />
                <RowDefinition Height="8" />
                <RowDefinition Height="{Binding DataContext.ScreenshotPanel.RowHeight, ElementName=Root}" />
                <RowDefinition Height="8" />
                <RowDefinition Height="{Binding DataContext.LogPanel.RowHeight, ElementName=Root}" />
            </Grid.RowDefinitions>

            <!-- 连接面板 -->
            <Border Grid.Row="0" Style="{StaticResource PanelCard}" Padding="12,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="⇄" Style="{StaticResource PanelGlyph}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="连接" Style="{StaticResource PanelHeaderText}" />
                            <Ellipse Width="8" Height="8" Margin="8,0,0,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#6E6E78" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentInstance.State}" Value="Connecting">
                                                <Setter Property="Fill" Value="#E0A030" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentInstance.State}" Value="Connected">
                                                <Setter Property="Fill" Value="#3FAE6A" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentInstance.State}" Value="Error">
                                                <Setter Property="Fill" Value="#E05C5C" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Margin="10,0,10,0" FontSize="11"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                   Text="{Binding CurrentInstance.DisplayName, FallbackValue=无实例, TargetNullValue=无实例}" />

                        <Button Grid.Column="3" Style="{StaticResource CollapseButton}"
                                Content="{Binding ConnectionPanel.Chevron}"
                                Command="{Binding ConnectionPanel.ToggleCommand}"
                                ToolTip="折叠 / 展开" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,8,0,0"
                          Visibility="{Binding ConnectionPanel.IsExpanded, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="{Binding CurrentInstance.StatusText}" />
                            <TextBlock Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis"
                                       Text="{Binding CurrentInstance.ResourceStatus}" Margin="0,2,0,0" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Opacity="0.7"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}运行库 {0}">
                                        <Binding Path="RuntimeVersion" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="连接" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                                    Command="{Binding CurrentInstance.ConnectCommand}"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="{DynamicResource AccentForegroundBrush}"
                                    BorderThickness="0" />
                            <Button Content="断开" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                                    Command="{Binding CurrentInstance.DisconnectCommand}" />
                            <Button Content="截图" Style="{StaticResource SmallButton}"
                                    Command="{Binding CurrentInstance.SaveScreenshotCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 截图面板 -->
            <Border Grid.Row="2" Style="{StaticResource PanelCard}" Padding="12,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="▣" Style="{StaticResource PanelGlyph}" />
                        <TextBlock Grid.Column="1" Text="实时截图" Style="{StaticResource PanelHeaderText}" />
                        <TextBlock Grid.Column="2" Margin="10,0" FontSize="11" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                   Text="{Binding CurrentInstance.FrameInfo}" />
                        <Button Grid.Column="3" Style="{StaticResource CollapseButton}"
                                Content="{Binding ScreenshotPanel.Chevron}"
                                Command="{Binding ScreenshotPanel.ToggleCommand}"
                                ToolTip="折叠 / 展开" />
                    </Grid>

                    <Border Grid.Row="1" CornerRadius="6" Background="{DynamicResource NavBackgroundBrush}"
                            Visibility="{Binding ScreenshotPanel.IsExpanded, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="6">
                                <Image Source="{Binding CurrentInstance.PreviewSource}"
                                       RenderOptions.BitmapScalingMode="LowQuality"
                                       SnapsToDevicePixels="True" />
                            </Viewbox>
                            <TextBlock Text="无画面（连接设备后自动刷新）"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentInstance.PreviewSource}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 日志面板 -->
            <Border Grid.Row="4" Style="{StaticResource PanelCard}" Padding="12,8" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="☰" Style="{StaticResource PanelGlyph}" />
                        <TextBlock Grid.Column="1" Text="运行日志" Style="{StaticResource PanelHeaderText}" />
                        <TextBlock Grid.Column="2" Margin="10,0" FontSize="11" VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                   Text="{Binding LogTailText}" />
                        <Button Grid.Column="3" Content="完整日志" Style="{StaticResource SmallButton}"
                                Height="22" Padding="8,0" Margin="0,0,6,0" FontSize="11"
                                Command="{Binding OpenLogsCommand}" />
                        <Button Grid.Column="4" Style="{StaticResource CollapseButton}"
                                Content="{Binding LogPanel.Chevron}"
                                Command="{Binding LogPanel.ToggleCommand}"
                                ToolTip="折叠 / 展开" />
                    </Grid>

                    <ListBox Grid.Row="1" x:Name="LogList" ItemsSource="{Binding LogTail}"
                             ItemContainerStyle="{StaticResource PlainListItemStyle}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             Visibility="{Binding LogPanel.IsExpanded, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TimeText}"
                                               Style="{StaticResource LogTimeText}" />
                                    <TextBlock Grid.Column="1" Text="{Binding LevelText}"
                                               Style="{StaticResource LogLevelText}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Message}"
                                               Style="{StaticResource LogMessageText}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
