<UserControl x:Class="MaaYys.App.Views.Pages.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
            <Setter Property="Margin" Value="0,10,0,6" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
        </Style>

        <Style x:Key="PlainListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="5" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：配置组 + 任务清单 -->
        <Border Grid.Column="0" Margin="0,0,12,0" Padding="12" CornerRadius="8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="任务" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TaskSummary}" FontSize="11" HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                    <TextBlock Text="配置组（任务与参数归属）" Style="{StaticResource FieldLabel}" />
                    <ComboBox Height="28" ItemsSource="{Binding ConfigurationNames}"
                              SelectedItem="{Binding SelectedConfiguration, Mode=TwoWay}" />
                </StackPanel>

                <TextBlock Grid.Row="2" Style="{StaticResource HintText}" Margin="0,0,0,6"
                           Text="勾选框 = 是否加入任务队列；点任务名编辑参数。" />

                <ListBox Grid.Row="3" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource PlainListItemStyle}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,2,0,0"
                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <WrapPanel>
                                        <TextBlock Text="{Binding OptionText}" FontSize="10"
                                                   Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                                        <TextBlock Text=" · " FontSize="10"
                                                   Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                                        <TextBlock Text="{Binding GroupText}" FontSize="10"
                                                   Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="4" Style="{StaticResource HintText}" Margin="0,6,0,0"
                           Text="{Binding CatalogHint}" />
            </Grid>
        </Border>

        <!-- 右：参数面板 + 编译预览 -->
        <Border Grid.Column="1" CornerRadius="8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 头部 -->
                <Border Grid.Row="0" Padding="14,10" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding TaskHeader}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TaskHint}" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="恢复本任务默认" Height="26" Padding="10,0" Margin="0,0,6,0"
                                    Command="{Binding ResetTaskCommand}" />
                            <Button Content="清空本组参数" Height="26" Padding="10,0"
                                    Command="{Binding ResetAllCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 参数区 -->
                <ScrollViewer Grid.Row="1" Padding="14,6,14,10" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding OptionRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="{Binding IndentMargin}" Padding="0,6"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <WrapPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" />
                                                <Border Margin="8,0,0,0" Padding="5,0" CornerRadius="3"
                                                        Background="{DynamicResource NavBackgroundBrush}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TypeLabel}" FontSize="10"
                                                               Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                                                </Border>
                                            </WrapPanel>

                                            <TextBlock Text="{Binding Description}" Style="{StaticResource HintText}"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />

                                            <!-- select / switch -->
                                            <Grid Margin="0,6,0,0" HorizontalAlignment="Left"
                                                  Visibility="{Binding IsSingleChoice, Converter={StaticResource BoolToVisibility}}">
                                                <ComboBox Height="28" Width="240"
                                                          ItemsSource="{Binding Choices}"
                                                          DisplayMemberPath="Label"
                                                          SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" />
                                                <!-- 没有 default_case 的选项默认是无覆盖状态，给个占位提示，别让用户以为界面坏了 -->
                                                <TextBlock Text="（未选择，按默认处理）" FontSize="11" Margin="9,0,0,0"
                                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                                           Foreground="{DynamicResource ForegroundSecondaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedIndex}" Value="-1">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <!-- checkbox -->
                                            <ItemsControl ItemsSource="{Binding Choices}" Margin="0,6,0,0"
                                                          Visibility="{Binding IsCheckbox, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Label}" FontSize="12"
                                                                  Margin="0,0,16,6"
                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- input -->
                                            <ItemsControl ItemsSource="{Binding Inputs}" Margin="0,4,0,0"
                                                          Visibility="{Binding IsInput, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="150" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                                       FontSize="11" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBox Height="26" VerticalContentAlignment="Center"
                                                                         Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                <TextBlock Text="{Binding Hint}" FontSize="10"
                                                                           Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 编译预览 -->
                        <TextBlock Text="编译后的 pipeline_override（P5 投递任务时使用）"
                                   Style="{StaticResource SectionTitle}" />
                        <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="11"
                                 Height="190" AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Background="{DynamicResource NavBackgroundBrush}"
                                 Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" Padding="8" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 底部消息 -->
                <Border Grid.Row="2" Padding="14,8" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
