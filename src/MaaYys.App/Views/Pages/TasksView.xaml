<UserControl x:Class="MaaYys.App.Views.Pages.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
            <Setter Property="Margin" Value="0,10,0,6" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
        </Style>

        <Style x:Key="PlainListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="5" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 重命名：编辑态切换 TextBox / TextBlock -->
        <Style x:Key="DisplayNameTextStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DisplayNameBoxStyle" TargetType="TextBox">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="1,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 队列项模板 -->
        <DataTemplate x:Key="QueueItemTemplate">
            <Grid Margin="2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 状态色条 -->
                <Border Grid.Column="0" x:Name="StatusBar" Width="4" CornerRadius="2"
                        Background="Transparent" VerticalAlignment="Stretch" />

                <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                          VerticalAlignment="Top" Margin="0,2,0,0" />

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding DisplayName}" FontSize="12"
                               Style="{StaticResource DisplayNameTextStyle}">
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding BeginEditCommand}" />
                        </TextBlock.InputBindings>
                    </TextBlock>

                    <TextBox Grid.Row="0" Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DisplayNameBoxStyle}"
                             LostFocus="AliasBox_LostFocus" KeyDown="AliasBox_KeyDown" />

                    <TextBlock Grid.Row="1" FontSize="10" Foreground="{DynamicResource ForegroundSecondaryBrush}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} · 实例 {1}">
                                <Binding Path="Name" />
                                <Binding Path="InstanceCount" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>

                <TextBlock Grid.Column="3" FontSize="10" Margin="6,0,0,0"
                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                           Text="{Binding InstanceCount, StringFormat='×{0}'}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InstanceCount}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter TargetName="StatusBar" Property="Background" Value="#2E7D32" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Pending">
                    <Setter TargetName="StatusBar" Property="Background" Value="#F9A825" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                    <Setter TargetName="StatusBar" Property="Background" Value="#1565C0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                    <Setter TargetName="StatusBar" Property="Background" Value="#9E9E9E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="StatusBar" Property="Background" Value="#C62828" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Stopped">
                    <Setter TargetName="StatusBar" Property="Background" Value="#EF6C00" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 队列项容器：右键菜单 -->
        <Style x:Key="QueueItemContainerStyle" TargetType="ListBoxItem" BasedOn="{StaticResource PlainListItemStyle}">
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="从此处运行" Command="{Binding RunFromHereCommand}" />
                        <MenuItem Header="重命名" Command="{Binding BeginEditCommand}" />
                        <MenuItem Header="上移" Command="{Binding MoveUpCommand}" />
                        <MenuItem Header="下移" Command="{Binding MoveDownCommand}" />
                        <Separator />
                        <MenuItem Header="删除" Command="{Binding RemoveCommand}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 选项行模板（任务级与全局级共用）：select/switch/checkbox/input 四种渲染 -->
        <DataTemplate x:Key="OptionRowTemplate">
            <Border Margin="{Binding IndentMargin}" Padding="0,6"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" />
                        <Border Margin="8,0,0,0" Padding="5,0" CornerRadius="3"
                                Background="{DynamicResource NavBackgroundBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TypeLabel}" FontSize="10"
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                        </Border>
                    </WrapPanel>

                    <TextBlock Text="{Binding Description}" Style="{StaticResource HintText}"
                               Margin="0,2,0,0"
                               Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />

                    <!-- select / switch -->
                    <Grid Margin="0,6,0,0" HorizontalAlignment="Left"
                          Visibility="{Binding IsSingleChoice, Converter={StaticResource BoolToVisibility}}">
                        <ComboBox Height="28" Width="240"
                                  ItemsSource="{Binding Choices}"
                                  DisplayMemberPath="Label"
                                  SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" />
                        <TextBlock Text="（未选择，按默认处理）" FontSize="11" Margin="9,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource ForegroundSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedIndex}" Value="-1">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- checkbox -->
                    <ItemsControl ItemsSource="{Binding Choices}" Margin="0,6,0,0"
                                  Visibility="{Binding IsCheckbox, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" FontSize="12"
                                          Margin="0,0,16,6"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- input -->
                    <ItemsControl ItemsSource="{Binding Inputs}" Margin="0,4,0,0"
                                  Visibility="{Binding IsInput, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                               FontSize="11" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBox Height="26" VerticalContentAlignment="Center"
                                                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{Binding Hint}" FontSize="10"
                                                   Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：任务队列 -->
        <Border Grid.Column="0" Margin="0,0,12,0" Padding="12" CornerRadius="8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="任务队列" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TaskSummary}" FontSize="11" HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="配置组" Style="{StaticResource FieldLabel}" />
                        <ComboBox Height="28" ItemsSource="{Binding ConfigurationNames}"
                                  SelectedItem="{Binding SelectedConfiguration, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="添加任务" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="AddTaskBox" Height="28" ItemsSource="{Binding AvailableTasks}"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="Name"
                                  ToolTip="把任务加入队列（可加多个同类实例）"
                                  SelectionChanged="AddTaskBox_SelectionChanged" />
                    </StackPanel>
                </Grid>

                <!-- 运行控制（P5.3 执行引擎） -->
                <Border Grid.Row="2" Margin="0,0,0,8" Padding="8,6" CornerRadius="6"
                        Background="{DynamicResource NavBackgroundBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="开始运行" Height="28" Padding="12,0" Margin="0,0,6,0"
                                Command="{Binding RunQueueCommand}"
                                ToolTip="按队列顺序执行所有启用的任务" />
                        <Button Grid.Column="1" Content="暂停/继续" Height="28" Padding="12,0" Margin="0,0,6,0"
                                Command="{Binding PauseResumeCommand}"
                                ToolTip="暂停会中止当前任务，继续时从该任务重新开始" />
                        <Button Grid.Column="2" Content="停止" Height="28" Padding="12,0"
                                Command="{Binding StopRunCommand}" />
                        <TextBlock Grid.Column="3" Text="{Binding RunStateText}" FontSize="11"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                    </Grid>
                </Border>

                <TextBlock Grid.Row="3" Style="{StaticResource HintText}" Margin="0,0,0,6"
                           Text="拖拽排序；双击或右键「重命名」改名；右键可「从此处运行」。" />

                <ListBox Grid.Row="4" x:Name="QueueList"
                         ItemsSource="{Binding Queue}"
                         SelectedItem="{Binding SelectedQueueItem, Mode=TwoWay}"
                         ItemTemplate="{StaticResource QueueItemTemplate}"
                         ItemContainerStyle="{StaticResource QueueItemContainerStyle}"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="QueueList_PreviewMouseLeftButtonDown"
                         MouseMove="QueueList_MouseMove"
                         DragOver="QueueList_DragOver"
                         Drop="QueueList_Drop"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                <TextBlock Grid.Row="5" Style="{StaticResource HintText}" Margin="0,6,0,0"
                           Text="{Binding CatalogHint}" />
            </Grid>
        </Border>

        <!-- 右：参数面板 + 编译预览（任务参数 / 全局选项 两个页） -->
        <Border Grid.Column="1" CornerRadius="8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0" BorderThickness="0" Padding="0">
                    <!-- 任务参数 -->
                    <TabItem Header="任务参数">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="14,10" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TaskHeader}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TaskHint}" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="恢复本任务默认" Height="26" Padding="10,0" Margin="0,0,6,0"
                                                Command="{Binding ResetTaskCommand}" />
                                        <Button Content="清空本组参数" Height="26" Padding="10,0"
                                                Command="{Binding ResetAllCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" Padding="14,6,14,10" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding OptionRows}"
                                                  ItemTemplate="{StaticResource OptionRowTemplate}" />

                                    <TextBlock Text="编译后的 pipeline_override（P5 投递任务时使用，已含全局选项层）"
                                               Style="{StaticResource SectionTitle}" />
                                    <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True"
                                             FontFamily="Consolas, Microsoft YaHei UI" FontSize="11"
                                             Height="190" AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             Background="{DynamicResource NavBackgroundBrush}"
                                             Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" Padding="8" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- 全局选项（MXU setting 扩展） -->
                    <TabItem Header="全局选项"
                             Visibility="{Binding HasGlobalOptions, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="14,10" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="全局选项" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="这些设置对本配置组的所有任务生效；任务级同名选项会覆盖它们。"
                                               Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Row="1" Padding="14,6,14,10" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding GlobalSections}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,4,0,10">
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource SectionTitle}" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource HintText}"
                                                               Margin="0,0,0,4"
                                                               Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                                                    <ItemsControl ItemsSource="{Binding Rows}"
                                                                  ItemTemplate="{StaticResource OptionRowTemplate}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="全局选项贡献的 pipeline_override（并入每个任务）"
                                               Style="{StaticResource SectionTitle}" />
                                    <TextBox Text="{Binding GlobalPreview, Mode=OneWay}" IsReadOnly="True"
                                             FontFamily="Consolas, Microsoft YaHei UI" FontSize="11"
                                             Height="150" AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             Background="{DynamicResource NavBackgroundBrush}"
                                             Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" Padding="8" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>

                <!-- 底部消息 -->
                <Border Grid.Row="1" Padding="14,8" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
