<UserControl x:Class="MaaYys.App.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">

            <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,10"
                       Text="缓存与资源维护。资源相关的清理在版本更新时自动完成，这里只保留用户需要手动介入的一项。" />

            <!-- ===== 图片缓存 ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="图片缓存" />
                            <TextBlock Text="{Binding CacheText}" FontSize="15" Margin="0,6,0,4"
                                       Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding CacheDetail}" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                       Text="正常情况下无需手动清理。缓存目录里的图片会随运行重新生成，删除不会影响任务执行；日志（*.log）不在清理范围内。" />
                        </StackPanel>

                        <Button Grid.Column="1" Content="清理图片缓存" Width="120" Height="34"
                                VerticalAlignment="Center"
                                Command="{Binding ClearCacheCommand}" />
                    </Grid>

                    <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding Message}"
                               Visibility="{Binding ShowMessage, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0"
                               Foreground="#E06C75"
                               Text="{Binding Message}"
                               Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- ===== 资源整理（自动、只读） ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="资源整理" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                               Text="资源版本更新后，旧版本留下的不可达节点、未引用模板图/模型与 *.bak 会在启动时自动清理并记录日志。受保护项（隐藏任务、活动轮换包、debug 兜底链、OCR 模型）永不清理。" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0"
                               Text="{Binding MaintenanceText}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
