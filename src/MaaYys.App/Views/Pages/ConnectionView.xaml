<UserControl x:Class="MaaYys.App.Views.Pages.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- WPF 默认 ListBoxItem 模板用系统前景色，暗色主题下未选中项是黑字不可读 -->
        <Style x:Key="DeviceListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="5" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：设备探测 -->
        <Border Grid.Column="0" Margin="0,0,12,0" Padding="14" CornerRadius="8"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="设备" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="刷新" Width="64" Height="28" HorizontalAlignment="Right"
                            Command="{Binding RefreshCommand}" />
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                    <TextBlock Text="窗口标题正则" FontSize="12"
                               Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                    <TextBox Text="{Binding TitleRegex, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,0" Height="26" />
                    <CheckBox Content="同时探测模拟器 (ADB)" IsChecked="{Binding IncludeAdb}"
                              Margin="0,8,0,0" FontSize="12" />
                </StackPanel>

                <ProgressBar Grid.Row="2" Height="3" IsIndeterminate="True" Margin="0,0,0,6"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                <ListBox Grid.Row="3" ItemsSource="{Binding Devices}"
                         SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource DeviceListItemStyle}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="11"
                                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 右：预览 + 参数 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="截图方式" FontSize="11"
                               Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                    <ComboBox Width="150" Height="28" Margin="0,3,0,0"
                              ItemsSource="{Binding ScreencapMethods}"
                              SelectedItem="{Binding SelectedScreencapMethod}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="输入方式" FontSize="11"
                               Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                    <ComboBox Width="170" Height="28" Margin="0,3,0,0"
                              ItemsSource="{Binding InputMethods}"
                              SelectedItem="{Binding SelectedInputMethod}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="预览帧率" FontSize="11"
                               Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                    <ComboBox Width="80" Height="28" Margin="0,3,0,0"
                              ItemsSource="{Binding FpsOptions}"
                              SelectedItem="{Binding TargetFps}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="连接" Width="76" Height="28" Margin="0,0,8,0"
                            Command="{Binding ConnectCommand}"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource AccentForegroundBrush}" BorderThickness="0" />
                    <Button Content="断开" Width="76" Height="28" Margin="0,0,8,0"
                            Command="{Binding DisconnectCommand}" />
                    <Button Content="保存截图" Width="88" Height="28"
                            Command="{Binding SaveScreenshotCommand}" />
                </StackPanel>
            </WrapPanel>

            <Border Grid.Row="1" Background="#101014" CornerRadius="8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Image Source="{Binding PreviewSource}" Stretch="Uniform" Margin="6" />
                    <TextBlock Text="连接后在此显示实时画面" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#7A7A85" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewSource}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="2,8,0,0">
                <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{Binding FrameInfo}" FontSize="11" Margin="0,3,0,0"
                           Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                <TextBlock FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource ForegroundSecondaryBrush}">
                    <Run Text="实际帧率 " />
                    <Run Text="{Binding ActualFps, Mode=OneWay, StringFormat={}{0:F1}}" />
                    <Run Text=" fps ｜ 诊断：" />
                    <Run Text="{Binding Diagnostic, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
