<UserControl x:Class="MaaYys.App.Views.Pages.TimersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="DayCheck" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TinyButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题区 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="定时任务" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                       Text="到点自动运行指定配置组。与 MAA 一致：定时随程序运行，关掉本页也不会失效；同一分钟只会触发一次，程序重启也不会补跑。" />
        </StackPanel>

        <!-- 工具条 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SchedulerText}" FontSize="12"
                               Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0"
                               Text="{Binding ConfigurationHint}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="立即检查" Style="{StaticResource TinyButton}" Height="30"
                            Command="{Binding CheckNowCommand}" />
                    <Button Content="新增定时" Style="{StaticResource TinyButton}" Height="30"
                            Command="{Binding AddTimerCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 列表 -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,4,0">
                <StackPanel>
                    <!-- 消息条 -->
                    <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                            Background="{DynamicResource NavBackgroundBrush}"
                            Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Message}" FontSize="11"
                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                            <Button Grid.Column="1" Content="✕" Width="22" Height="22" Padding="0"
                                    FontSize="10" Command="{Binding ClearMessageCommand}" />
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Timers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 第一行：时间 + 周计划 + 开关 -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 时间 -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ComboBox Width="62" Height="28"
                                                          ItemsSource="{Binding HourOptions}"
                                                          SelectedItem="{Binding Hour, Mode=TwoWay}" />
                                                <TextBlock Text=":" Margin="4,0" FontSize="14" VerticalAlignment="Center" />
                                                <ComboBox Width="62" Height="28"
                                                          ItemsSource="{Binding MinuteOptions}"
                                                          SelectedItem="{Binding Minute, Mode=TwoWay}" />
                                            </StackPanel>

                                            <!-- 周计划 -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        Margin="16,0,8,0" VerticalAlignment="Center">
                                                <CheckBox Style="{StaticResource DayCheck}" Content="一" IsChecked="{Binding IsMonday, Mode=TwoWay}" />
                                                <CheckBox Style="{StaticResource DayCheck}" Content="二" IsChecked="{Binding IsTuesday, Mode=TwoWay}" />
                                                <CheckBox Style="{StaticResource DayCheck}" Content="三" IsChecked="{Binding IsWednesday, Mode=TwoWay}" />
                                                <CheckBox Style="{StaticResource DayCheck}" Content="四" IsChecked="{Binding IsThursday, Mode=TwoWay}" />
                                                <CheckBox Style="{StaticResource DayCheck}" Content="五" IsChecked="{Binding IsFriday, Mode=TwoWay}" />
                                                <CheckBox Style="{StaticResource DayCheck}" Content="六" IsChecked="{Binding IsSaturday, Mode=TwoWay}" />
                                                <CheckBox Style="{StaticResource DayCheck}" Content="日" IsChecked="{Binding IsSunday, Mode=TwoWay}" />
                                                <TextBlock Text="{Binding WeekdaysText}" FontSize="11" Margin="2,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                                            </StackPanel>

                                            <!-- 开关与操作 -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox Content="启用" FontSize="11" VerticalAlignment="Center"
                                                          IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                                <CheckBox Content="强制启动" FontSize="11" Margin="10,0,0,0"
                                                          VerticalAlignment="Center"
                                                          ToolTip="到点时若已有队列在跑：勾选则先停止再启动本配置，不勾选则跳过本次"
                                                          IsChecked="{Binding ForceStart, Mode=TwoWay}" />
                                                <Button Content="试跑" Style="{StaticResource TinyButton}"
                                                        Command="{Binding RunNowCommand}" />
                                                <Button Content="删除" Style="{StaticResource TinyButton}"
                                                        Command="{Binding RemoveCommand}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- 第二行：配置组 + 备注 + 下次触发 -->
                                        <Grid Grid.Row="1" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="运行配置组" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                                                <ComboBox Width="180" Height="26" Margin="8,0,0,0"
                                                          ItemsSource="{Binding ConfigurationNames}"
                                                          SelectedItem="{Binding Configuration, Mode=TwoWay}" />
                                                <TextBlock Text="备注" FontSize="11" Margin="12,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                                                <TextBox Width="140" Height="26" Margin="8,0,0,0"
                                                         VerticalContentAlignment="Center" FontSize="11"
                                                         Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="备注名（可空），仅用于区分同点触发的多条计划" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource ForegroundSecondaryBrush}">
                                                <Run Text="下次触发：" />
                                                <Run Text="{Binding NextRunText, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空状态 -->
                    <Border Style="{StaticResource Card}" Padding="16"
                            Visibility="{Binding NoTimers, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="还没有定时计划" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                                       Text="点右上角「新增定时」添加一条：选好时间与配置组即可，到点会自动运行该配置组的任务队列。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
