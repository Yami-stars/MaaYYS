<UserControl x:Class="MaaYys.App.Views.Pages.Settings.StorageSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">

            <TextBlock Text="日志与缓存" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource SettingsHint}" Margin="0,0,0,12"
                       Text="日志分两层：内存决定「界面上能翻多少」，文件决定「关掉程序后还能不能回看」。默认只开内存；开启落盘后按大小滚动，磁盘占用有上界。" />

            <!-- ===== 内存日志 ===== -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="内存日志" />

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="138" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="时间格式" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,12,8"
                                  Style="{StaticResource SettingsCombo}"
                                  ItemsSource="{Binding TimeFormats}"
                                  SelectedIndex="{Binding TimeFormatIndex, Mode=TwoWay}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource SettingsHint}" Margin="0,0,0,8"
                                   Text="长跑排查要看节点间隔，建议带毫秒" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="保留条数" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,0"
                                 Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding LogCapacity}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource SettingsHint}"
                                   Text="超出后从最旧开始丢弃（100–200000）。2 万条约占 10–20 MB" />
                    </Grid>

                    <CheckBox Content="记录节点级事件（Node.*，量大，排查时才开）" Margin="0,12,0,0"
                              IsChecked="{Binding LogNodeEvents, Mode=TwoWay}" />
                    <CheckBox Content="警告 / 错误自动附截图卡片" Margin="0,8,0,0"
                              IsChecked="{Binding LogThumbnails, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- ===== 日志落盘 ===== -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="日志落盘" />

                    <CheckBox Content="把日志同时写入文件（崩溃后还能回看）" Margin="0,6,0,0"
                              IsChecked="{Binding FileLogEnabled, Mode=TwoWay}" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="138" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="目录" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,8,8"
                                 Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding FileLogDirectory}" />
                        <Button Grid.Row="0" Grid.Column="2" Content="打开目录" Width="86" Height="30" Margin="0,0,0,8"
                                Command="{Binding OpenLogFolderCommand}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="单文件上限（MB）" />
                        <TextBox Grid.Row="1" Grid.Column="1" Width="90" HorizontalAlignment="Left" Margin="0,0,8,8"
                                 Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding FileLogMaxSizeMb}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="保留份数" />
                        <TextBox Grid.Row="2" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                 Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding FileLogMaxFiles}" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="138" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="落盘最低级别" />
                        <ComboBox Grid.Column="1" Margin="0,0,12,0"
                                  Style="{StaticResource SettingsCombo}"
                                  ItemsSource="{Binding FileLevels}"
                                  SelectedIndex="{Binding FileLogLevelIndex, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource SettingsHint}"
                                   Text="「调试」会非常大；排查问题用「信息」就够" />
                    </Grid>

                    <TextBlock Style="{StaticResource SettingsHint}" Margin="0,12,0,0" Text="当前文件" />
                    <TextBlock Style="{StaticResource SettingsValue}" Margin="0,2,0,0"
                               Text="{Binding FileLogPath}" TextTrimming="CharacterEllipsis" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="立即刷盘" Width="90" Height="28"
                                Command="{Binding FlushLogCommand}" />
                        <TextBlock Style="{StaticResource SettingsHint}" Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Message}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== 图片缓存 ===== -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="图片缓存" />
                            <TextBlock Text="{Binding CacheText}" FontSize="15" Margin="0,6,0,4"
                                       Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                            <TextBlock Style="{StaticResource SettingsHint}" Text="{Binding CacheDetail}" />
                            <TextBlock Style="{StaticResource SettingsHint}" Margin="0,8,0,0"
                                       Text="正常情况下无需手动清理。缓存目录里的图片会随运行重新生成，删除不会影响任务执行；日志文件（*.log）不在清理范围内。" />
                        </StackPanel>

                        <Button Grid.Column="1" Content="清理图片缓存" Width="120" Height="34"
                                VerticalAlignment="Center"
                                Command="{Binding ClearCacheCommand}" />
                    </Grid>

                    <TextBlock Style="{StaticResource SettingsHint}" Margin="0,10,0,0"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding Message}"
                               Visibility="{Binding ShowMessage, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Style="{StaticResource SettingsHint}" Margin="0,10,0,0"
                               Foreground="#E06C75"
                               Text="{Binding Message}"
                               Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- ===== 资源整理（自动、只读） ===== -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="资源整理" />
                    <TextBlock Style="{StaticResource SettingsHint}" Margin="0,4,0,0"
                               Text="资源版本更新后，旧版本留下的不可达节点、未引用模板图/模型与 *.bak 会在启动时自动清理并记录日志。受保护项（隐藏任务、活动轮换包、debug 兜底链、OCR 模型）永不清理。" />
                    <TextBlock Style="{StaticResource SettingsHint}" Margin="0,10,0,0"
                               Text="{Binding MaintenanceText}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
