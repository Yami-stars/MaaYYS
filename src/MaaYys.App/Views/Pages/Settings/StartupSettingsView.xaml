<UserControl x:Class="MaaYys.App.Views.Pages.Settings.StartupSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">

            <TextBlock Text="启动" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource SettingsHint}" Margin="0,0,0,12"
                       Text="前置程序就是游戏本体。挂机最常见的失败是「程序开了、游戏没开」：连不上的时候会先把它拉起来，等窗口真的出现再连接，不用死等固定秒数。" />

            <!-- ===== 前置程序 ===== -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="前置程序" />

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="138" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="程序路径" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,8,8"
                                 Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding PreProgramPath}" />
                        <Button Grid.Row="0" Grid.Column="2" Content="浏览…" Width="72" Height="30" Margin="0,0,0,8"
                                Command="{Binding BrowseCommand}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="启动参数" />
                        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                                 Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding PreProgramArguments}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="等待窗口（秒）" />
                        <TextBox Grid.Row="2" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                 Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding PreProgramWaitSeconds}" />
                    </Grid>

                    <TextBlock Style="{StaticResource SettingsHint}" Margin="0,10,0,0"
                               Text="{Binding PreProgramSummary}" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox Content="连接时若没找到窗口，自动启动前置程序" VerticalAlignment="Center"
                                  IsChecked="{Binding AutoLaunchOnConnect, Mode=TwoWay}" />
                        <Button Content="立即启动一次" Width="110" Height="28" Margin="20,0,0,0"
                                Command="{Binding LaunchNowCommand}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource SettingsHint}" Margin="0,8,0,0"
                               Text="{Binding LaunchMessage}" />
                </StackPanel>
            </Border>

            <!-- ===== 开机自启 ===== -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="开机自启" />

                    <CheckBox Content="随 Windows 启动（写入当前用户的启动项，不需要管理员权限）"
                              Margin="0,6,0,0"
                              IsChecked="{Binding AutoStartWithWindows, Mode=TwoWay}" />

                    <CheckBox Content="静默启动（开机自启时窗口最小化，不打断正在用的程序）"
                              Margin="0,10,0,0"
                              IsEnabled="{Binding AutoStartWithWindows}"
                              IsChecked="{Binding SilentStart, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource SettingsHint}" Margin="0,12,0,0"
                               Text="{Binding AutoStartStatus}" />

                    <TextBlock Style="{StaticResource SettingsHint}" Margin="0,6,0,0"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding Message}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
