<UserControl x:Class="MaaYys.App.Views.Pages.Settings.NotificationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">

            <TextBlock Text="通知" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource SettingsHint}" Margin="0,0,0,12"
                       Text="应用内提示 + 外部 Webhook 通知。卡住超时只提醒不打断任务（与「运行」页的停滞超时停机是两回事）。本批只做 Webhook 一个外部通道。" />

            <!-- ===== 应用内通知 ===== -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="应用内通知" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="138" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="卡住超时（秒）" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,12,8" Text="{Binding StuckTimeoutSeconds}"
                                 Style="{StaticResource SettingsTextBox}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource SettingsHint}" Margin="0,0,0,8"
                                   Text="运行期间超过该时长没有任何任务状态变化，就弹一条「可能卡住」提示。0 = 关闭" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="提醒间隔（分）" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,0" Text="{Binding ReminderIntervalMinutes}"
                                 Style="{StaticResource SettingsTextBox}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource SettingsHint}"
                                   Text="运行期间每隔该分钟数提示一次「仍在运行」。0 = 关闭" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== 外部通知 ===== -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingsSectionTitle}" Text="外部通知（Webhook）" />
                        <CheckBox Grid.Column="1" Content="启用外部通知" IsChecked="{Binding ExternalEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Style="{StaticResource SettingsHint}" Margin="0,6,0,10" Text="{Binding ExternalStatus}" />

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="138" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="Webhook 地址" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,12,8" Text="{Binding WebhookUrl}"
                                 Style="{StaticResource SettingsTextBox}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource SettingsHint}" Margin="0,0,0,8"
                                   Text="接收端 URL，例如 https://example.com/hook 或本地调试用的监听地址" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="请求方法" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,8"
                                  Style="{StaticResource SettingsCombo}"
                                  ItemsSource="{Binding WebhookMethods}"
                                  SelectedIndex="{Binding WebhookMethodIndex, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource SettingsHint}" Margin="0,0,0,8"
                                   Text="POST 或 PUT（GET 不带请求体）" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="Content-Type" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,12,0" Text="{Binding WebhookContentType}"
                                 Style="{StaticResource SettingsTextBox}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource SettingsHint}"
                                   Text="空则默认 application/json" />
                    </Grid>

                    <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="触发条件" Margin="0,12,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="队列完成" IsChecked="{Binding OnComplete, Mode=TwoWay}" Margin="0,0,16,0" />
                        <CheckBox Content="队列失败" IsChecked="{Binding OnFailure, Mode=TwoWay}" Margin="0,0,16,0" />
                        <CheckBox Content="检测到卡住" IsChecked="{Binding OnStuck, Mode=TwoWay}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="自定义请求头" Margin="0,12,0,6" />
                    <TextBox Style="{StaticResource SettingsTextBox}" Height="56" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" Text="{Binding WebhookHeaders}"
                             ToolTip="每行一条，格式 Key: Value；空行忽略" />
                    <TextBlock Style="{StaticResource SettingsHint}" Margin="0,4,0,0"
                               Text="例如：Authorization: Bearer xxxx" />

                    <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="请求体模板" Margin="0,12,0,6" />
                    <TextBox Style="{StaticResource SettingsTextBox}" Height="120" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" Text="{Binding WebhookBodyTemplate}"
                             ToolTip="支持变量 {title} {message} {time} {trigger}；留空用默认 JSON 模板" />
                    <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="模板预览" Margin="0,12,0,6" />
                    <TextBox Style="{StaticResource SettingsTextBox}" Height="100" TextWrapping="Wrap" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" Text="{Binding BodyPreview, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- ===== 操作 ===== -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="发送测试消息" Width="140" Height="30" Margin="0,0,12,0"
                                Command="{Binding SendTestCommand}" />
                        <Button Content="恢复默认" Width="100" Height="30"
                                Command="{Binding ResetCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SettingsHint}" Margin="0,10,0,0" Text="{Binding Message}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
