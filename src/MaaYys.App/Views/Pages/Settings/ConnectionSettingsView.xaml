<UserControl x:Class="MaaYys.App.Views.Pages.Settings.ConnectionSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">

            <TextBlock Text="连接" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource SettingsHint}" Margin="0,0,0,12"
                       Text="桌面端（Win32）控制器的截图与输入方式。这里配的是全局默认值：新建实例按它初始化，已有实例仍以「多实例」页的单独配置为准；要统一改，用下面的「应用到全部实例」。" />

            <!-- ===== 输入与截图方式 ===== -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="输入与截图方式" />

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="138" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="截图方式" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,12,8"
                                  Style="{StaticResource SettingsCombo}"
                                  ItemsSource="{Binding ScreencapMethods}"
                                  SelectedItem="{Binding ScreencapMethod, Mode=TwoWay}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource SettingsHint}" Margin="0,0,0,8"
                                   Text="FramePool 最快且对后台窗口有效；画面异常时依次试 PrintWindow / GDI / DXGI" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="鼠标输入" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,8"
                                  Style="{StaticResource SettingsCombo}"
                                  ItemsSource="{Binding InputMethods}"
                                  SelectedItem="{Binding InputMethod, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource SettingsHint}" Margin="0,0,0,8"
                                   Text="SendMessage 可后台点击（窗口被遮挡也能点）；Seize / LegacyEvent 需要窗口在前台" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="键盘输入" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,12,0"
                                  Style="{StaticResource SettingsCombo}"
                                  ItemsSource="{Binding InputMethods}"
                                  SelectedItem="{Binding KeyboardMethod, Mode=TwoWay}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource SettingsHint}"
                                   Text="一般与鼠标保持一致即可；输入不生效时优先换这一项" />
                    </Grid>

                    <Button Content="应用到全部实例" Width="140" Height="30" Margin="0,14,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding ApplyToAllCommand}" />
                    <TextBlock Style="{StaticResource SettingsHint}" Margin="0,8,0,0"
                               Text="{Binding Message}" />
                </StackPanel>
            </Border>

            <!-- ===== 实时预览 ===== -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="实时预览" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="138" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="预览帧率" />
                        <TextBox Grid.Column="1" Margin="0,0,12,0" Text="{Binding PreviewFps}"
                                 Style="{StaticResource SettingsTextBox}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource SettingsHint}" Text="{Binding PreviewFpsHint}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== 窗口匹配 ===== -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="窗口匹配" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="138" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="标题正则（默认）" />
                        <TextBox Grid.Column="1" Margin="0,0,12,0" Text="{Binding Win32TitleRegex}"
                                 Style="{StaticResource SettingsTextBox}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource SettingsHint}"
                                   Text="新建实例时的默认值。标题里带区服名（如「阴阳师-网易」）时用正则更稳，例如「阴阳师」" />
                    </Grid>
                    <TextBlock Style="{StaticResource SettingsHint}" Margin="0,10,0,0"
                               Text="提示：改这里的值不会影响已有实例；已有实例请在「多实例」页编辑。" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
