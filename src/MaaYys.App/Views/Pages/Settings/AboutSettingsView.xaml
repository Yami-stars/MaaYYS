<UserControl x:Class="MaaYys.App.Views.Pages.Settings.AboutSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">

            <TextBlock Text="关于" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource SettingsHint}" Margin="0,0,0,12"
                       Text="版本与各类清单的实际路径。「资源没有更新」「配置改了没生效」这类问题，第一眼看的就是这三条路径指到哪儿了。" />

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="版本" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="程序版本" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingsValue}" Margin="0,0,0,8"
                                   Text="{Binding AppVersion}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="运行库版本" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsValue}"
                                   Text="{Binding FrameworkVersion}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="路径" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="程序目录" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingsValue}" Margin="0,0,0,8"
                                   Text="{Binding BaseDirectory}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding BaseDirectory}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="配置清单" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsValue}" Margin="0,0,0,8"
                                   Text="{Binding ConfigPath}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ConfigPath}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="实例清单" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource SettingsValue}" Margin="0,0,0,8"
                                   Text="{Binding InstanceStorePath}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding InstanceStorePath}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="资源清单" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource SettingsValue}"
                                   Text="{Binding InterfacePath}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding InterfacePath}" />
                    </Grid>

                    <TextBlock Style="{StaticResource SettingsHint}" Margin="0,12,0,0"
                               Text="{Binding ConfigState}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
