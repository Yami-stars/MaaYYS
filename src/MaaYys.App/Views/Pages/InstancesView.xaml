<UserControl x:Class="MaaYys.App.Views.Pages.InstancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- 分组小标题 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>

        <!-- 列表项：显式给前景/选中态。WPF 默认 ListBoxItem 模板用系统前景色，
             暗色主题下未选中项会变成黑字不可读（P2.3 连接页也有同样问题，已同步修）。 -->
        <Style x:Key="PlainListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="5" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 字段标签 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：实例列表 + 运行控制 + 实时预览 -->
        <Border Grid.Column="0" Margin="0,0,12,0" Padding="12" CornerRadius="8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="实例" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="＋ 新建" Width="76" Height="28" HorizontalAlignment="Right"
                            Command="{Binding AddCommand}" />
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding Instances}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource PlainListItemStyle}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,5">
                                <TextBlock Text="{Binding DisplayName}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding DeviceSummary}" FontSize="11"
                                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="复制" Width="64" Height="28" Margin="0,0,6,0" Command="{Binding DuplicateCommand}" />
                    <Button Content="删除" Width="64" Height="28" Command="{Binding DeleteCommand}" />
                </StackPanel>

                <!-- 实时预览：只在当前激活标签抓帧，切走的标签保持连接但不占 CPU -->
                <Border Grid.Row="3" Height="150" Margin="0,10,0,0" CornerRadius="6" Background="#101014"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Image Source="{Binding Selected.PreviewSource, Mode=OneWay}" Stretch="Uniform" Margin="4" />
                        <TextBlock Text="连接后显示实时画面" FontSize="12" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="#7A7A85">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Selected.PreviewSource}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="连接" Width="64" Height="28" Margin="0,0,6,0"
                            Command="{Binding Selected.ConnectCommand}"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource AccentForegroundBrush}" BorderThickness="0" />
                    <Button Content="断开" Width="64" Height="28" Margin="0,0,6,0"
                            Command="{Binding Selected.DisconnectCommand}" />
                    <Button Content="截图" Width="64" Height="28"
                            Command="{Binding Selected.SaveScreenshotCommand}" />
                </StackPanel>

                <TextBlock Grid.Row="5" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundSecondaryBrush}">
                    <Run Text="{Binding Selected.StatusText, Mode=OneWay}" />
                    <LineBreak />
                    <Run Text="{Binding Selected.FrameInfo, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </Border>

        <!-- 右：配置编辑器 -->
        <Border Grid.Column="1" CornerRadius="8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶栏：名称 + 保存 -->
                <Border Grid.Row="0" Padding="14,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="实例名" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <TextBox Width="200" Height="28" VerticalContentAlignment="Center"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="未保存" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="#E0A030"
                                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="还原" Width="64" Height="28" Margin="0,0,8,0" Command="{Binding RevertCommand}" />
                            <Button Content="保存" Width="76" Height="28" Command="{Binding SaveCommand}"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="{DynamicResource AccentForegroundBrush}" BorderThickness="0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" Padding="14,0,14,10" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 设备绑定 -->
                        <TextBlock Text="设备绑定" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="设备类型" Style="{StaticResource FieldLabel}" />
                                <ComboBox Height="28" SelectedIndex="{Binding SelectedDeviceKindIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="桌面端（Win32）" />
                                    <ComboBoxItem Content="模拟器（ADB）" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Win32 -->
                            <StackPanel Grid.Column="1" Visibility="{Binding IsWin32Mode, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="窗口标题正则" Style="{StaticResource FieldLabel}" />
                                        <TextBox Height="28" VerticalContentAlignment="Center"
                                                 Text="{Binding Win32TitleRegex, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="窗口类名正则（可空）" Style="{StaticResource FieldLabel}" />
                                        <TextBox Height="28" VerticalContentAlignment="Center"
                                                 Text="{Binding Win32ClassRegex, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- ADB -->
                            <StackPanel Grid.Column="1" Visibility="{Binding IsAdbMode, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="ADB 地址（host:port）" Style="{StaticResource FieldLabel}" />
                                        <TextBox Height="28" VerticalContentAlignment="Center"
                                                 Text="{Binding AdbAddress, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="ADB 配置 JSON" Style="{StaticResource FieldLabel}" />
                                        <TextBox Height="28" VerticalContentAlignment="Center"
                                                 Text="{Binding AdbConfig, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding DeviceHint}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ForegroundSecondaryBrush}" />

                        <!-- 连接参数 -->
                        <TextBlock Text="连接参数" Style="{StaticResource SectionTitle}" />
                        <WrapPanel>
                            <StackPanel Width="150" Margin="0,0,12,8">
                                <TextBlock Text="截图方式" Style="{StaticResource FieldLabel}" />
                                <ComboBox Height="28" ItemsSource="{Binding ScreencapMethods}"
                                          SelectedItem="{Binding ScreencapMethod, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Width="180" Margin="0,0,12,8">
                                <TextBlock Text="输入方式" Style="{StaticResource FieldLabel}" />
                                <ComboBox Height="28" ItemsSource="{Binding InputMethods}"
                                          SelectedItem="{Binding InputMethod, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Width="90" Margin="0,0,12,8">
                                <TextBlock Text="预览帧率" Style="{StaticResource FieldLabel}" />
                                <ComboBox Height="28" ItemsSource="{Binding FpsOptions}"
                                          SelectedItem="{Binding PreviewFps, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,0,8">
                                <TextBlock Text="资源集" Style="{StaticResource FieldLabel}" />
                                <ComboBox Height="28" ItemsSource="{Binding ResourceNames}"
                                          SelectedItem="{Binding ResourceName, Mode=TwoWay}" />
                                <!-- P2.5：不重连、不重启，直接替换引擎资源（官服 ↔ B站服等渠道切换） -->
                                <Button Content="热切换资源" Height="24" Margin="0,4,0,0" FontSize="11"
                                        Command="{Binding SwitchResourceCommand}" />
                            </StackPanel>
                        </WrapPanel>

                        <TextBlock FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                   Text="{Binding ResourceHint}" />

                        <TextBlock FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                   Text="提示：桌面端截图方式默认 FramePool（P1.4 实测无黑边、坐标精确）；输入方式默认 SendMessage（主界面需窗口前台，二级面板可后台）。" />

                        <!-- 配置组（P2.6）：任务勾选的真实归属，实例只记「用哪一组」 -->
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="配置组" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding ConfigurationHint}" FontSize="11" HorizontalAlignment="Right"
                                       Margin="0,12,0,0"
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                        </Grid>
                        <WrapPanel>
                            <ComboBox Height="28" Width="220" Margin="0,0,8,8"
                                      ItemsSource="{Binding ConfigurationNames}"
                                      SelectedItem="{Binding SelectedConfigurationName, Mode=TwoWay}" />
                            <TextBox Height="28" Width="150" Margin="0,0,8,8"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ConfigurationNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="新建/重命名时使用的名字，留空则自动取名" />
                            <Button Content="新建" Height="28" MinWidth="56" Margin="0,0,8,8"
                                    Command="{Binding NewConfigurationCommand}" />
                            <Button Content="复制" Height="28" MinWidth="56" Margin="0,0,8,8"
                                    Command="{Binding DuplicateConfigurationCommand}" />
                            <Button Content="重命名" Height="28" MinWidth="64" Margin="0,0,8,8"
                                    Command="{Binding RenameConfigurationCommand}" />
                            <Button Content="删除" Height="28" MinWidth="56" Margin="0,0,8,8"
                                    Command="{Binding DeleteConfigurationCommand}" />
                            <Button Content="导入…" Height="28" MinWidth="64" Margin="0,0,8,8"
                                    Command="{Binding ImportConfigurationCommand}" />
                            <Button Content="导出…" Height="28" MinWidth="64" Margin="0,0,8,8"
                                    Command="{Binding ExportConfigurationCommand}" />
                        </WrapPanel>

                        <!-- 任务集 -->
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="任务集" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding TaskSummary}" FontSize="11" HorizontalAlignment="Right"
                                       Margin="0,12,0,0"
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                        </Grid>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                MaxHeight="180">
                            <ListBox ItemsSource="{Binding TaskSelections}" Background="Transparent"
                                     BorderThickness="0" Padding="4"
                                     ItemContainerStyle="{StaticResource PlainListItemStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" FontSize="12"
                                                  Margin="2,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" />
                                                <TextBlock Text="{Binding Entry}" FontSize="11" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- 备注 -->
                        <TextBlock Text="备注" Style="{StaticResource SectionTitle}" />
                        <TextBox Height="52" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="{Binding CatalogHint}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                        <TextBlock FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ForegroundSecondaryBrush}">
                            <Run Text="清单文件：" />
                            <Run Text="{Binding StorePath, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- 底部消息 -->
                <Border Grid.Row="2" Padding="14,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Foreground" Value="#E05C5C" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
