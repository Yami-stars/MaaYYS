<UserControl x:Class="MaaYys.App.Views.Pages.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
        </Style>

        <Style x:Key="LogListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 级别配色：错误红 / 警告黄 / 信息强调色 / 调试次要色 -->
        <Style x:Key="LevelText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Error">
                    <Setter Property="Foreground" Value="#E05A5A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warn">
                    <Setter Property="Foreground" Value="#D9A227" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Info">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="运行日志" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0"
                       Text="引擎事件、agent 输出、队列与定时消息汇总在此。警告/错误会自动附当前截图卡片（点击查看）。" />
        </StackPanel>

        <!-- 工具条：第一行过滤条件 + 右侧动作按钮，第二行开关（显式两行，窄窗口也不会被裁切） -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="级别" Style="{StaticResource FieldLabel}" />
                <ComboBox Width="92" Height="26" Margin="0,0,10,0"
                          ItemsSource="{Binding LevelChoices}"
                          SelectedIndex="{Binding LevelIndex, Mode=TwoWay}" />

                <TextBlock Text="来源" Style="{StaticResource FieldLabel}" />
                <ComboBox Width="96" Height="26" Margin="0,0,10,0"
                          ItemsSource="{Binding SourceChoices}"
                          SelectedIndex="{Binding SourceIndex, Mode=TwoWay}" />

                <TextBlock Text="时间" Style="{StaticResource FieldLabel}" />
                <ComboBox Width="128" Height="26" Margin="0,0,10,0"
                          ItemsSource="{Binding TimeFormats}"
                          SelectedIndex="{Binding TimeFormatIndex, Mode=TwoWay}" />

                <TextBox Width="168" Height="26" VerticalContentAlignment="Center"
                         Text="{Binding Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="搜索消息 / 详情 / 分类 / 来源 / 实例名" />
            </WrapPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="复制" Height="26" Padding="10,0" Margin="0,0,6,0" Command="{Binding CopyCommand}" />
                <Button Content="导出…" Height="26" Padding="10,0" Margin="0,0,6,0" Command="{Binding ExportCommand}" />
                <Button Content="清空" Height="26" Padding="10,0" Command="{Binding ClearCommand}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                <CheckBox Content="自动滚动" FontSize="12" Margin="0,0,14,0" VerticalAlignment="Center"
                          IsChecked="{Binding AutoScroll, Mode=TwoWay}" />
                <CheckBox Content="暂停刷新" FontSize="12" Margin="0,0,14,0" VerticalAlignment="Center"
                          IsChecked="{Binding Paused, Mode=TwoWay}"
                          ToolTip="日志仍在记录，取消暂停后一次性补齐" />
                <CheckBox Content="节点级事件" FontSize="12" VerticalAlignment="Center"
                          IsChecked="{Binding NodeEvents, Mode=TwoWay}"
                          ToolTip="记录 Node.* 事件（识别/动作逐节点），量大，排查卡点时再开" />
            </StackPanel>
        </Grid>

        <!-- 列头 -->
        <Grid Grid.Row="2" Margin="6,0,6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="时间" Style="{StaticResource HintText}" />
            <TextBlock Grid.Column="1" Text="级别" Style="{StaticResource HintText}" />
            <TextBlock Grid.Column="2" Text="来源" Style="{StaticResource HintText}" />
            <TextBlock Grid.Column="3" Text="实例" Style="{StaticResource HintText}" />
            <TextBlock Grid.Column="4" Text="消息" Style="{StaticResource HintText}" />
            <TextBlock Grid.Column="5" Text="截图" Style="{StaticResource HintText}" />
        </Grid>

        <!-- 日志列表（虚拟化 + 回收，长跑不卡） -->
        <ListBox Grid.Row="3" x:Name="LogList"
                 ItemsSource="{Binding Rows}"
                 ItemContainerStyle="{StaticResource LogListItemStyle}"
                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                 Background="{DynamicResource NavBackgroundBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding TimeText}" Style="{StaticResource MonoText}"
                                   Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding LevelText}" Style="{StaticResource LevelText}" />
                        <TextBlock Grid.Column="2" Text="{Binding Source}" Style="{StaticResource MonoText}"
                                   Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="{Binding Scope}" Style="{StaticResource MonoText}"
                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="4" Text="{Binding Message}" Style="{StaticResource MonoText}"
                                   TextWrapping="Wrap" />

                        <Border Grid.Column="5" Margin="4,0,0,0" CornerRadius="4"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="点击查看截图">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.OpenImageCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>
                            <Image Source="{Binding Thumbnail}" Height="46" Stretch="Uniform" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 底部：计数 + 提示 -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding CountText}" Style="{StaticResource HintText}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Message}" Style="{StaticResource HintText}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
